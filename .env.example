# MongoDB Connection Strings
SOURCE_URI=mongodb+srv://<user>:<password>@<source-cluster>.mongodb.net/?retryWrites=true&w=majority
TARGET_URI=mongodb+srv://<user>:<password>@<target-cluster>.mongodb.net/?retryWrites=true&w=majority

# Database Names
SOURCE_DB=source_database_name
TARGET_DB=target_database_name

# Sync Settings (Optional overrides)
SYNC_INTERVAL_MINUTES=30
BATCH_SIZE=2000
LOG_INTERVAL=5000
SAFETY_OVERLAP_SECONDS=60
